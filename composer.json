{
  "name": "jeoip/ip2location",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Jeoip\\Ip2Location\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "ext-gmp": "*",
    "geoip2/geoip2": "^3.0",
    "illuminate/support": "^9.0",
    "jeoip/common": "dev-master"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.4.1",
    "friendsofphp/php-cs-fixer": "^3.1",
    "orchestra/testbench": "^7.1"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Jeoip\\Ip2Location\\GeoIPServiceProvider"
      ]
    }
  },
  "scripts": {
    "test:types": "vendor/bin/phpstan analyze",
    "test:phpunit": "vendor/bin/phpunit",
    "test:codestyle": "vendor/bin/php-cs-fixer fix -v --dry-run --stop-on-violation --using-cache=no",
    "test": [
      "@test:types",
      "@test:phpunit",
      "@test:codestyle"
    ]
  },
  "repositories": {
    "common": {
      "type": "vcs",
      "url": "https://github.com/itsmattius/jeoip-common"
    }
  }
}